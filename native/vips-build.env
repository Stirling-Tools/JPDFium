# Pinned libvips + codec versions for the from-source builds (Linux/macOS in
# release.yml / snapshot.yml) and the Windows vcpkg prebuild (prebuild-vips.yml).
#
# The `Vips Drift Check` workflow (.github/workflows/vips-drift.yml) compares
# these against upstream and opens a `vips-drift` issue when something newer is
# available, so the bump is a tracked decision instead of a silent rebuild
# against a moving upstream. Keep this file and native/vips.version in sync
# when bumping: vips.version pins the *prebuilt* release, this file pins the
# *source* build inputs.
VIPS_VERSION=v8.18.6
LIBHEIF_VERSION=v1.23.4
AOM_VERSION=v3.15.1
KVAZAAR_VERSION=v2.3.2
